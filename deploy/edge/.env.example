# Pi 5 (edge VLAN). Copy to .env and fill in. Never commit .env.
DOMAIN=jahmed.cloud
SERVICES_HOST_IP=10.10.0.22

# DetectionOnly for 7 days, then On (one site at a time; see the Caddyfile).
WAF_MODE=DetectionOnly

# Same values as in deploy/services/.env
CROWDSEC_CADDY_KEY=
PORTAL_WAF_SHIP_TOKEN=
# Set on the Pi 4 with: docker compose exec crowdsec cscli machines add edge-pi5 --password <this>
CROWDSEC_EDGE_PASSWORD=
