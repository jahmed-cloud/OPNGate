# Caddy on the Pi 5, reached through the OPNsense port forward (WAN 80/443 -> 10.10.0.21).
# DNS is proxied by Cloudflare, so every legitimate request arrives from a Cloudflare address:
#   - Caddy gets Let's Encrypt certificates itself (HTTP-01 over port 80, as NPM did).
#   - The real client IP comes from CF-Connecting-IP, trusted only from Cloudflare's ranges.
#   - Requests that skip Cloudflare and hit the static IP directly are dropped (cf_only).
# The portal runs on the Pi 4 and is reached over HTTPS, trusting only the private CA from deploy/pki.
{
	admin off
	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips/). They change rarely; keep in
		# sync with cf_only below.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
	crowdsec {
		api_url {$CROWDSEC_LAPI}
		api_key {$CROWDSEC_CADDY_KEY}
		ticker_interval 15s
	}
}

# Drop anything that didn't come through Cloudflare (someone hitting the static IP directly).
# Your LAN is allowed so local devices can still use the sites if DNS ever points them here.
(cf_only) {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 private_ranges
	abort @not_cloudflare
}

(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
			mode 0644    # the WAF shipper reads it as a non-root user
		}
		format json
	}
}

# OWASP Core Rule Set via Coraza. WAF_MODE=DetectionOnly for the first 7 days, then On, one site at a time
# (give a site its own copy of this snippet with "SecRuleEngine On" to switch only that site).
(waf) {
	coraza_waf {
		load_owasp_crs
		directives `
			Include @coraza.conf-recommended
			Include @crs-setup.conf.example
			Include @owasp_crs/*.conf
			SecRuleEngine {$WAF_MODE}
			SecAuditEngine RelevantOnly
			SecAuditLogRelevantStatus "^(?:5|40[0-35-9]|4[1-9])"
			SecAuditLogFormat JSON
			# Keep transaction metadata and rule messages; omit headers and bodies (credentials/cookies).
			# Rule matched-data can still be sensitive: keep this log private and rotate it.
			SecAuditLogParts AHZ
			SecAuditLogType Serial
			SecAuditLog /var/log/caddy/coraza-audit.log
			SecAuditLogFileMode 0644
		`
	}
}

# Ask the portal before forwarding anything (one FIDO2/TOTP login covers all admin apps).
(portal_tls) {
	transport http {
		tls_trust_pool file /pki/ingest-ca.pem
	}
}

(portal_gate) {
	forward_auth https://{$PORTAL_UPSTREAM} {
		uri /auth/verify
		copy_headers X-Portal-User X-Portal-Role
		header_up X-Real-IP {client_ip}
		import portal_tls
	}
}

waf.{$DOMAIN} {    # WAF-OPNsense portal
	import access_log
	route {
		import cf_only
		# Internal endpoints are for the WAF shipper on this host only, never from the internet.
		respond /internal/* 404
		crowdsec
		import waf
		reverse_proxy https://{$PORTAL_UPSTREAM} {
			header_up X-Real-IP {client_ip}
			import portal_tls
		}
	}
}
# ---- Site templates ----
# app:        WAF + bans. For sites the public or your apps/phones talk to directly.
# admin_app:  WAF + bans + portal login (FIDO2/TOTP). For consoles only you use.
# *_tls:      same, for upstreams that serve HTTPS with a self-signed certificate (internal hop only).
(app) {
	import access_log
	route {
		import cf_only
		crowdsec
		import waf
		reverse_proxy {args[0]}
	}
}

(admin_app) {
	import access_log
	route {
		import cf_only
		crowdsec
		import waf
		import portal_gate
		reverse_proxy {args[0]}
	}
}

(app_tls) {
	import access_log
	route {
		import cf_only
		crowdsec
		import waf
		reverse_proxy https://{args[0]} {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}

# ---- Your sites (converted from Nginx Proxy Manager, 2026-11-01) ----

# Behind the portal login: consoles and APIs with no strong login of their own.
gauc.{$DOMAIN} {
	import admin_app 10.10.0.21:8384    # Guacamole
}
wol.{$DOMAIN} {
	import admin_app 10.10.0.21:8090    # Wake-on-LAN (UpSnap)
}

# Vaultwarden: the vault API stays reachable for the mobile apps and browser extensions,
# which can't do the portal login; /admin gets the portal login on top.
vault.{$DOMAIN} {
	import access_log
	route {
		import cf_only
		crowdsec
		import waf
		@admin path /admin /admin/*
		handle @admin {
			import portal_gate
			reverse_proxy 10.10.0.21:8900
		}
		reverse_proxy 10.10.0.21:8900
	}
}

# Plain-HTTP requests for unknown hosts are refused (known hosts get an automatic HTTPS redirect).
http:// {
	respond 404
}
