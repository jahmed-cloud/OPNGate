# /etc/gw-hostfw.env on each Pi. Interim isolation while everything shares one LAN (no VLANs yet).
LAN_IF=eth0
LAN_NET=10.10.0.0/24
FIREWALL_IP=10.10.0.1     # firewall's LAN address (igc2, confirmed)
EDGE_IP=10.10.0.21        # Pi 5
SERVICES_IP=10.10.0.22    # Pi 4
ADMIN_IP=10.99.99.110     # your PC on MGMT (routed by the firewall): the only host allowed to SSH in
# Pi 5 only: app upstreams Caddy may reach, as ip:port, space separated
UPSTREAMS="10.10.0.21:8384 10.10.0.21:8090 10.10.0.21:8900 10.10.0.20:8080"
