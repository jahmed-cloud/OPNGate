# Pi 4 (services VLAN). Copy to .env and fill in. Never commit .env.
DOMAIN=example.com
PORTAL_SUBDOMAIN=opngate
# Set only during an existing-hostname migration; keep old passkeys usable there.
PORTAL_LEGACY_ORIGIN=
SERVICES_HOST_IP=10.10.0.22
EDGE_HOST_IP=10.10.0.21

# openssl rand -hex 32 for each
CROWDSEC_CADDY_KEY=
CROWDSEC_OPNSENSE_KEY=
# openssl rand -hex 24; the portal reads active bans with it (read-only bouncer key).
CROWDSEC_PORTAL_KEY=
# Shared with the Pi 5's waf-shipper (same value in deploy/edge/.env)
PORTAL_WAF_SHIP_TOKEN=

PORTAL_RP_NAME=OPNGate
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PORTAL_RETENTION_DAYS=90
# Time zone for pages until a browser reports its own (e.g. Asia/Kolkata).
PORTAL_TZ=UTC
